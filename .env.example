# Bio Studio Configuration (Optional)
# Bio Studio is designed local-first and works out of the box with zero configuration.

# Server Port (Default: 8080)
PORT=8080

# JanitorAI Gateway Endpoint (Default: https://janitorai.com/hampter)
JANITOR_GATEWAY_URL=https://janitorai.com/hampter

# Session Token (Do NOT commit real tokens here; tokens should be entered via the UI in-memory)
# JANITOR_SESSION_TOKEN=
